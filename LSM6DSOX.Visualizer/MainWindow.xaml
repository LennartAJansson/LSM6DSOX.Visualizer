<Window x:Class="LSM6DSOX.Visualizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hx="http://helix-toolkit.org/wpf"
        xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        Title="IMU – LSM6DSOX" Height="800" Width="1100"
        Background="#FF1E1E1E">
    <Window.Resources>
        <Style x:Key="CardLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Gray" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="CardValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#FF2D2D30" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="MinWidth" Value="180" />
        </Style>
        <Style x:Key="LegendText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="Gray" />
            <Setter Property="Margin" Value="10" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Statusrad -->
        <Border Grid.Row="0" Background="#FF2D2D30" Padding="10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock Text="Tidsfönster:" Foreground="Gray" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox x:Name="WindowSelector" Width="90" SelectedIndex="1"
                              SelectionChanged="WindowSelector_SelectionChanged">
                        <ComboBoxItem Content="30 s" Tag="30" />
                        <ComboBoxItem Content="1 min" Tag="60" />
                        <ComboBoxItem Content="5 min" Tag="300" />
                        <ComboBoxItem Content="Allt" Tag="0" />
                    </ComboBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="StatusDot" Width="12" Height="12" Fill="Gray" Margin="0,0,8,0" />
                    <TextBlock x:Name="StatusText" Text="Ansluter till NATS..." Foreground="White" VerticalAlignment="Center" />
                    <TextBlock x:Name="SampleCountText" Text="" Foreground="Gray" Margin="20,0,0,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="SenderText" Text="" Foreground="Gray" Margin="20,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Senaste värden -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="10,10,10,0">
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Acceleration" Style="{StaticResource CardLabel}" />
                    <TextBlock x:Name="AccelValue" Text="–" Foreground="#FFFF7043" Style="{StaticResource CardValue}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Vinkelhastighet" Style="{StaticResource CardLabel}" />
                    <TextBlock x:Name="GyroValue" Text="–" Foreground="#FF81C784" Style="{StaticResource CardValue}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Roll" Style="{StaticResource CardLabel}" />
                    <TextBlock x:Name="RollValue" Text="–" Foreground="#FF4FC3F7" Style="{StaticResource CardValue}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Pitch" Style="{StaticResource CardLabel}" />
                    <TextBlock x:Name="PitchValue" Text="–" Foreground="#FF4FC3F7" Style="{StaticResource CardValue}" />
                </StackPanel>
            </Border>
            <TextBlock x:Name="LastUpdateText" Text="" Foreground="Gray" VerticalAlignment="Bottom" Margin="4,0,0,10" />
        </StackPanel>

        <!-- 3D-vy och diagram -->
        <Grid Grid.Row="2" Margin="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="0,0,6,0">
                <hx:HelixViewport3D x:Name="Viewport" ZoomExtentsWhenLoaded="True"
                                    Background="#FF252526"
                                    ShowCoordinateSystem="True" ShowViewCube="True">
                    <hx:SunLight />

                    <ModelVisual3D>
                        <ModelVisual3D.Content>
                            <Model3DGroup>
                                <!-- Referensplan (golv) -->
                                <GeometryModel3D>
                                    <GeometryModel3D.Geometry>
                                        <MeshGeometry3D
                                            Positions="-3,-3,-1 3,-3,-1 3,3,-1 -3,3,-1"
                                            TriangleIndices="0,1,2 0,2,3" />
                                    </GeometryModel3D.Geometry>
                                    <GeometryModel3D.Material>
                                        <DiffuseMaterial Brush="#FF3A3A3A" />
                                    </GeometryModel3D.Material>
                                </GeometryModel3D>
                            </Model3DGroup>
                        </ModelVisual3D.Content>
                    </ModelVisual3D>

                    <!-- Sensorkuben -->
                    <ModelVisual3D x:Name="SensorCube">
                        <ModelVisual3D.Content>
                            <Model3DGroup>
                                <GeometryModel3D x:Name="CubeGeometry">
                                    <GeometryModel3D.Material>
                                        <DiffuseMaterial Brush="#FF4FC3F7" />
                                    </GeometryModel3D.Material>
                                </GeometryModel3D>
                            </Model3DGroup>
                        </ModelVisual3D.Content>
                        <ModelVisual3D.Transform>
                            <RotateTransform3D>
                                <RotateTransform3D.Rotation>
                                    <QuaternionRotation3D x:Name="CubeRotation" />
                                </RotateTransform3D.Rotation>
                            </RotateTransform3D>
                        </ModelVisual3D.Transform>
                    </ModelVisual3D>

                    <!-- Accelerationsvektor -->
                    <hx:ArrowVisual3D x:Name="AccelArrow"
                                      Point1="0,0,0" Point2="0,0,1"
                                      Diameter="0.06"
                                      Fill="#FFFF7043" />
                </hx:HelixViewport3D>

                <TextBlock Style="{StaticResource LegendText}" VerticalAlignment="Bottom" HorizontalAlignment="Left">
                    <Run Text="■" Foreground="#FF4FC3F7" /><Run Text=" Orientering     " />
                    <Run Text="■" Foreground="#FFFF7043" /><Run Text=" Accelerationsvektor" />
                </TextBlock>
            </Grid>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <ScottPlot:WpfPlot x:Name="AccelPlot" Grid.Row="0" Margin="0,0,0,3" />
                <TextBlock Grid.Row="0" Style="{StaticResource LegendText}" VerticalAlignment="Top" HorizontalAlignment="Right">
                    <Run Text="■" Foreground="#FFFF7043" /><Run Text=" X   " />
                    <Run Text="■" Foreground="#FF81C784" /><Run Text=" Y   " />
                    <Run Text="■" Foreground="#FF4FC3F7" /><Run Text=" Z" />
                </TextBlock>

                <ScottPlot:WpfPlot x:Name="GyroPlot" Grid.Row="1" Margin="0,3,0,0" />
                <TextBlock Grid.Row="1" Style="{StaticResource LegendText}" VerticalAlignment="Top" HorizontalAlignment="Right">
                    <Run Text="■" Foreground="#FFFF7043" /><Run Text=" X   " />
                    <Run Text="■" Foreground="#FF81C784" /><Run Text=" Y   " />
                    <Run Text="■" Foreground="#FF4FC3F7" /><Run Text=" Z" />
                </TextBlock>
            </Grid>
        </Grid>
    </Grid>
</Window>
